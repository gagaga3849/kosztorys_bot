# LLM provider (litellm - pick one provider's key based on LLM_MODEL)
LLM_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Speech-to-text for voice messages (litellm - same provider-key convention as LLM_MODEL above).
# Groq's Whisper endpoint is fast/free-tier friendly and reuses GROQ_API_KEY if already set.
TRANSCRIPTION_MODEL=groq/whisper-large-v3-turbo

# Telegram (the only channel required for the v1 production Definition of Done)
TELEGRAM_BOT_TOKEN=
# Set the same value as the `secret_token` param when calling Telegram's `setWebhook` API -
# app.py verifies every incoming webhook request against this before processing it.
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp / Viber - optional, both adapters are v1 stubs (NotImplementedError) until a real
# integration is built. Leave blank to keep those webhook routes disabled (they return 501).
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VIBER_BOT_TOKEN=

# Database (Postgres, async via asyncpg)
DATABASE_URL=postgresql+asyncpg://kosztorys:kosztorys@localhost:5432/kosztorys

# Where generated Kosztorys PDFs are written before being sent back to the client
OUTPUT_DIR=./output

# Optional: forward EXPERT_REQUIRED (heritage) handoffs to a human admin via the same
# MessengerAdapter contract. Must be one of: telegram, whatsapp, viber.
ADMIN_CHANNEL=
ADMIN_USER_ID=
